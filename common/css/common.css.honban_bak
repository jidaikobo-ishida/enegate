/*Products*/
#products .productstop { margin:35px auto 20px !important;}
#products .catalllink { padding:35px 0; position:relative;}
#products .catalllink img { float:left;}
#products .cat-listlink li A{
	padding:0 8px;
	width:auto;
	line-height:30px;
	font-size:1.2em;
	color:#000;
	background:#D7D7D7;
  	border-left:1px solid #FFF;
  	border-right:1px solid #FFF;
	float:left;
}
#products .cat-listlink li A:hover { color:#FFF; background:#4378A3;}
#products .catlist { width:100%; display:table; padding:30px 0; border-bottom:1px solid #979797;}
#products .catlist:last-child { border:none; margin-bottom:70px;}

#products .cat_title { display:table-cell; width:175px; height:100px; max-height:100px; text-align:center; background: url(../../products/img/cat_back.png) no-repeat; vertical-align:middle;}
#products .val { vertical-align:top; padding-top:20px;}
#products .valone { vertical-align:top; padding-top:35px;}
#products .cat_title h3 {font-size:2.0em; color:#FFF; line-height:1.5;}
#products .cat_link { display:table-cell; padding-left:55px; vertical-align:middle;}
#products .cat_link li{
display:block;
padding-left:22px !important;
position: relative;
color: #000;
line-height:2.2;
vertical-align: middle;
text-decoration: none;
font-size:1.5em;
}
#products .cat_link .inline li{ display:inline-block; width:45%;}

#products .cat_link li A { color:#000;}
#products .cat_link li A:hover { color:#666 !important;}

#products .cat_link li::before,
#products .cat_link li::after{
position: absolute;
top: 0;
bottom: 0;
left: 0;
margin: auto;
content: "";
vertical-align: middle;
}

#products .cat_link li::before{
width: 13px;
height: 13px;
-webkit-border-radius: 10%;
border-radius: 10%;
background: #D11319;
}
#products .cat_link li::after{
left: 2px;
width: 5px;
height: 5px;
border-top: 2px solid #fff;
border-right: 2px solid #fff;
-webkit-transform: rotate(45deg);
transform: rotate(45deg);
}

