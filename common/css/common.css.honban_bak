#jireisin .voicebox .imgbox P { font-size:1.3em;}
#jireisin .voicebox .nametxt { font-size:1.3em; text-align:right; margin-right:10px;}
#jireisin .about { padding:35px 0 50px; border-top:1px solid #CCC;}
#jireisin .about img { margin:0 0 0 50px; float:right;}
#jireisin .about .addtxt { width:600px; padding:10px; background:#F1F1F1;}
#jireisin .about .addtxt P { margin-bottom:0;}

#metainfo .section { width:850px; margin:0 auto; padding:0 0 30px 0;}
#metainfo .btmline { border-bottom:1px solid #CCC;}
#metainfo .metaoutline h2 { margin-bottom:20px; font-size:2.6em; color:#2B7DC9;}
#metainfo .metaoutline P { font-size:1.4em;}
#metainfo .metaoutline .copy { width:660px; float:right;} 
#metainfo .metaoutline .copy P { margin-bottom:15px;}
#metainfo .metaoutline .img { width:190px; text-align:center; float:left;}
#metainfo .metaoutline .atttxt { margin-bottom:15px;}
#metainfo .metaoutline .atttxt li{ font-size:1.3em; text-indent:-4em; padding-left:4em;}
#metainfo .metaoutline blockquote { font-size:1.3em;}
#metainfo  .icontltle { margin:30px 0 20px; font-size:2.0em; font-weight:600; color:#2B7DC9; vertical-align:middle;}
#metainfo  .icontltle img { margin-right:10px; vertical-align:middle;}
#metainfo .baloonr {
	position: relative;
	display: inline-block;
	width:420px;
	padding: 10px;
	background: #E8F0FC;
	border:1px solid #DCE5F6;
	float:left;
	}
#metainfo .baloonr:before{
	content: "";
	position: absolute;
	top: 50%;
	left: 100%;
	margin-top: -15px;
	border: 20px solid transparent;
	border-left: 20px solid #E8F0FC;
}
#metainfo .baloonend {
	width:410px;
	padding:10px;
	background: #E8F0FC;
	border:1px solid #DCE5F6;
	float:right;
	}
#metainfo .baloonr P,
#metainfo .baloonend P { font-size:1.4em; padding-top:45px;}
#metainfo .baloonr img,
#metainfo .baloonend img { margin-right:10px; float:left;}
#metainfo .metainfo { width:414px; padding:15px; border:1px solid #CCC; text-align:center;}
#metainfo .metainfo h4,
#metainfo .meritrbox h4 { margin-bottom:15px; font-size:1.8em; color:#2B7DC9; text-align:left;}
#metainfo .metainfo P { margin-bottom:10px; text-align:left;}
#metainfo .meritl{ width:425px; margin-bottom:15px; padding-left:66px; float:left;}
#metainfo .meritr { width:400px; margin-bottom:15px; float:right;}
#metainfo .meritl img,
#metainfo .meritr img { display: block; margin:0 10px 0 0; float:left;}
#metainfo .meritl P,
#metainfo .meritr P { display: block; margin-top:10px; font-size:1.6em;}
#metainfo .meritrbox { width:100%; margin-bottom:20px; padding:15px; border:1px solid #CCC; }
#metainfo .meritrbox h4 .mid { font-size:1.2em;}
#metainfo .meritrbox h4 .noicon {
	margin:0 5px 0 10px;
	padding:1px 6px;
	text-align: center;
	color: #FFF;
	font-weight: bold;
	font-family: helvetica;
	background: #2A7CC8;
	border-radius:3px;}
#metainfo .itemspec { width:100%; margin:10px 0 15px; border-top:1px solid #CCC; border-bottom:1px solid #CCC; border-top:1px solid #CCC;}
#metainfo .itemspec th { padding:5px 10px; font-size:1.4em; text-align:center; background:#F2F6F8; vertical-align:top; border-bottom:solid 1px #CCC; vertical-align:middle;}
#metainfo .itemspec td { padding:5px 10px; font-size:1.4em; text-align:center; border-right:solid 1px #CCC; border-bottom:solid 1px #CCC;}
#metainfo .itemspec .big { font-size:1.2em;}
#metainfo .mintxt { font-size:13px !important; text-indent:-1em; padding-left:1em;}
#metainfo .itemspec .hikakuk {
	display:block;
	margin:0 5px 0 10px;
	padding:1px 6px;
	text-align: center;
	color: #FFF;
	font-weight: bold;
	font-family: helvetica;
	background: #2A7CC8;
	border-radius:3px;}
#metainfo .point ol {
	width:680px;
	margin: 0;
	padding: 0;
	list-style: none;
	counter-reset: yourDefinition;
	float:right;
}
#metainfo .point ol li {
	padding-left: 28px;
	text-indent: -28px;
	font-size:1.4em;
	margin:5px 0;
}
#metainfo .point ol li:before {
	counter-increment: yourDefinition;
	content: counter(yourDefinition);
	display: inline-block;
	margin-right: 10px;
	width: 18px;
	height: 18px;
	text-align: center;
	color: #FFF;
	font-weight: bold;
	line-height:18px;
	font-family: helvetica;
	text-indent: 0;
	background: #2A7CC8;
	border-radius:5px;
}
#metainfo .point h3 {
	position: relative;
	display: inline-block;
	padding:0 0 0;
	margin:54px 0 0;
	font-size:2.2em;
	font-weight:normal;
	color:#2A7CC8;
	float:left;
}
#metainfo .point h3::after{
  content: '';
  width: 80px;
  height: 80px;
  border-top: solid 1px #2A7CC8;
  border-right: solid 1px #2A7CC8;
  -ms-transform: rotate(45deg);
  -webkit-transform: rotate(45deg);
  transform: rotate(45deg);
  position: absolute;
  top: -45%;
  left: 60px;
  margin-top: -8px;
}
#metainfo .toptxt { padding-bottom:25px;}
#metainfo .topimg { margin-left:10px; float:right;}
#metainfo .topimg img { margin:0 0 0 10px; float:left;}
#metainfo .infocomment { width:400px; padding:10px; color:#2A7CC8; border:1px solid #EDF1FA;}
#metainfo .infocomment p { font-size:1.3em;}
#metainfo .linebox{ margin:30px 0; width:50%; float:left; box-sizing:border-box; position:relative;}
#metainfo .linebox:first-child { border-right:1px solid #CCC;}
#metainfo .linebox:last-child { padding:0 0 0 30px;}
#metainfo .linebox h2 { margin-top:0 !important;}
#metainfo .linebox:first-child P { padding:0 30px 0 0;}
#metainfo .koujioshirase { margin:0 10px 0 50px;}
#metainfo .fukusou { width:250px; position:absolute; top:70px; left:30px;}
#metainfo .sagyouin { margin-top:10px;}
#metainfo .onegai {
	list-style: none;
	counter-reset: yourDefinition;
}

#metainfo .onegai li {
	width:28.5%;
	display:inline-block;
	margin-left:38px;
	padding:0 10px 0 0;
	text-indent:0;
	font-size:1.4em;
	box-sizing:border-box;
	vertical-align:top;
	position:relative;
	box-sizing:border-box;

}
#metainfo .onegai li:last-child { padding-right:0;}
#metainfo .onegai li:before {
	counter-increment: yourDefinition;
	content: counter(yourDefinition);
	float:left;
	margin:0 10px 0 -38px;
	width: 28px;
	height: 28px;
	font-size:24px;
	text-align: center;
	color: #2A7CC8;
	line-height:30px;
	text-indent: 0;
	background: #E7EFFB;
	border-radius:3px;
}

#metafaq .faql { width:45%; float:left;}
#metafaq .faqr { width:45%; float:right;}
#metafaq .faqline { border-bottom:1px solid #CCC;}
#metafaq .qaq {
	position:relative;
    display:block;
	margin:10px 0;
	padding:0;
	font-size:1.4em;
	color:#2A7CC8;
    cursor:pointer;}
#metafaq .qaq span {
	margin-right:10px;
	padding:0 10px;
	color:#2A7CC8;
	font-weight:600;
	border-right:1px solid #CCC;
	}
#metafaq .qaa{ 
	display:none; 
	margin:0 0 10px 34px;
	font-size:1.4em;
	background:#F3F7FA;
	text-indent:-40px;
	padding:0 10px 0 40px;}
#metafaq .qaa span{
	margin-right:10px;
	padding:0 10px;
	color:#29BEFF;
	font-weight:600;
	border-right:1px solid #CCC;
	}
#metafaq .qaq::before,
#metafaq .qaq::after,
#metafaq .qaq.active::before,
#metafaq .qaq.active::after{
position: absolute;
top: 0;
bottom: 0;
right: 0;
margin: auto;
content: "";
vertical-align: middle;
}

#metafaq .qaq::before{
width: 13px;
height: 13px;
-webkit-border-radius: 10%;
border-radius: 10%;
background: #E0E8EB;
}
#metafaq .qaq::after{
top:-2px;
right: 3px;
width: 5px;
height: 5px;
border-top: 2px solid #2A7CC8;
border-right: 2px solid #2A7CC8;
-webkit-transform: rotate(135deg);
transform: rotate(135deg);
}

#metafaq .qaq.active::before{
	
width: 13px;
height: 13px;
-webkit-border-radius: 10%;
border-radius: 10%;
background: #2A7CC8;
}
#metafaq .qaq.active::after{
top:2px;
right: 3px;
width: 5px;
height: 5px;
border-top: 2px solid #E0E8EB;
border-right: 2px solid #E0E8EB;
-webkit-transform: rotate(315deg);
transform: rotate(315deg);
}

.problbgbtn {
	position: relative;
	display: inline-block;
	padding:6px 12px 6px 25px;
	margin:15px 10px 10px 0;
	font-size:1.3em;
	color:#2A7CC8;
	background:#E7EFFB;
	 border:1px solid #DBE4F5;
}
.problbgbtn::before{
  content: '';
  width: 6px;
  height: 6px;
  border: 0px;
  border-top: solid 2px #2A7CC8;
  border-right: solid 2px #2A7CC8;
  -ms-transform: rotate(45deg);
  -webkit-transform: rotate(45deg);
  transform: rotate(45deg);
  position: absolute;
  top: 50%;
  left: 10px;
  margin-top: -4px;
}
.problbgbtn:hover {
	color:#E7EFFB; 
	background:#2A7CC8;
}
.problbgbtn:hover::before{
  border-top: solid 2px #E7EFFB;
  border-right: solid 2px #E7EFFB;
}

.casewhbgbtn {
	margin:15px 0;
	position: relative;
	display: inline-block;
	padding:6px 12px 6px 25px;
	margin:15px 10px 0 0;
	font-size:1.3em;
	color:#2A7CC8;
	background:#FFF;
	 border:1px solid #F1F1F1;
}
.casewhbgbtn::before{
  content: '';
  width: 6px;
  height: 6px;
  border: 0px;
  border-top: solid 2px #2A7CC8;
  border-right: solid 2px #2A7CC8;
  -ms-transform: rotate(45deg);
  -webkit-transform: rotate(45deg);
  transform: rotate(45deg);
  position: absolute;
  top: 50%;
  left: 10px;
  margin-top: -4px;
}
.casewhbgbtn:hover {
	color:#E7EFFB; 
	background:#2A7CC8;
}
.casewhbgbtn:hover::before{
  border-top: solid 2px #E7EFFB;
  border-right: solid 2px #E7EFFB;
}



/*Company*/
/*旧調整用*/
#list #article { width:950px; clear:both; }

#list #mainContent {float:right; width:690px; margin:8px 25px 50px 25px !important; font-size:1.1em;}

#list .leftsubnav {margin:10px 0 50px 0; font-size:0.78em;}

#list #breadcrumbs { padding-bottom:20px;font-size:0.78em;}
/**/

#company .topinfo { min-height:620px;}
#company .topmainnav { padding:15px 0 0;}
#company .topmainnav li A {
	display:block;
	margin:0 10px 50px 0;
	width:310px;
	height:155px;
	font-size:1.5em; 
	line-height:1.0; 
	color:#FFF;
	float:left;
	box-sizing: border-box;}
	
#company .topmainnav li img { display:inline-block; margin-right:28px; vertical-align:middle;}
#company .topmainnav li span { display:inline-block; vertical-align:middle;}
#company .topmainnav .philosophy img {margin-right:8px !important;}

#company .topmainnav .message A{ background:#2B7DC4;}
#company .topmainnav .profile A { background:#65AB5D;}
#company .topmainnav .philosophy A { background:#E2BF5D;}
#company .topmainnav li:last-child A { margin-right:0;}
#company .topmainnav large { font-family: 'Open Sans', sans-serif; display:block; font-size:1.4em; line-height:1.2; font-weight:bold; margin-bottom:12px}

#company .topsuvnav li A{ position:relative; display:block; margin:0 18px 18px 0;padding:0 0 0 28px; width:224px; font-size:1.5em; line-height:50px; background:#F2F2F2; border:1px solid #B8B9B9; float:left;box-sizing: border-box;}
#company .topsuvnav li:nth-child(4n) A { margin-right:0;}
#company .topsuvnav A { display:block; color:#000;}
#company .topsuvnav A:hover { background:#FFF;}
#company .topsuvnav li A::before{
  content: '';
  width: 6px;
  height: 6px;
  border: 0px;
  border-top: solid 2px #808080;
  border-right: solid 2px #808080;
  -ms-transform: rotate(45deg);
  -webkit-transform: rotate(45deg);
  transform: rotate(45deg);
  position: absolute;
  top: 50%;
  left: 10px;
  margin-top: -4px;
}

#message .messagetitle { margin-bottom:40px;}
#quality .noinfo{ width:300px; padding-top:15px; padding-right:10px; padding-bottom:50px; padding-left:10px; background:#EEE; float:left;}
#kankyou .noinfo { width:300px; padding:15px; background:#EEE; float:left;}
#quality .pdfinfo,
#kankyou .pdfinfo { float:right;}
#quality .pdfinfo img,
#kankyou .pdfinfo img{ margin:0 5px 10px 5px;}
#quality .noinfo h3, 
#kankyou .noinfo h3{ margin-bottom:15px; padding:10 0 0 15px; font-size:1.5em; color:#2B7DC1; line-height:1.5; background:url(../img/bl_dot.png) no-repeat left 5px; background-size:12px auto;}
#quality .noinfo dl,
#kankyou .noinfo dl { padding:3px 15px;margin-bottom:9px;}
#quality .noinfo dt,
#quality .noinfo dd,
#kankyou .noinfo dt,
#kankyou .noinfo dd { font-size:1.4em;}
#quality .noinfo dd,
#kankyou .noinfo dd {margin-left:5em;margin-top:-1.75em;}
#rinen .rinentxt { margin:5px 0 0 45px;}
#rinen .rinentxt li { font-size:2.1em; padding:6px 10px 6px 36px; background:url(../../company/img/gr_arrow.png) left center no-repeat;}

#division .debbox { padding:20px 0; margin:0 25px 25px 0; width:230px; float:left; text-align:center; background:#E7EFFB; border:1px solid #DBE4F5; box-sizing: border-box;}
#division .debbox:nth-child(3n+5) { margin-right:0;}
#division .debbox h3 { padding:15px 0 10px; font-weight:bold;}
#division .debbox A.morelink{
	position: relative;
	display: inline-block;
	padding:6px 12px 6px 25px;
	font-size:1.3em;
	color:#2A7CC8;
	background:#FFF;
}

#division .debbox A.morelink::before{
  content: '';
  width: 6px;
  height: 6px;
  border: 0px;
  border-top: solid 2px #2A7CC8;
  border-right: solid 2px #2A7CC8;
  -ms-transform: rotate(45deg);
  -webkit-transform: rotate(45deg);
  transform: rotate(45deg);
  position: absolute;
  top: 50%;
  left: 10px;
  margin-top: -4px;
}
#division .debbox A.morelink:hover { color:#FFF; background:#2A7CC8;} 
#division .debbox A.morelink:hover::before{
  border-top: solid 2px #FFF;
  border-right: solid 2px #FFF;
}
#division .debbox A.nolink{
	position: relative;
	display: inline-block;
	padding:6px 12px 6px 25px;
	font-size:1.3em;
	color:#FFF;
	background:#CCC;
	cursor: default;
}

#division .debbox A.nolink::before{
  content: '';
  width: 6px;
  height: 6px;
  border: 0px;
  border-top: solid 2px #FFF;
  border-right: solid 2px #FFF;
  -ms-transform: rotate(45deg);
  -webkit-transform: rotate(45deg);
  transform: rotate(45deg);
  position: absolute;
  top: 50%;
  left: 10px;
  margin-top: -4px;
}

#division .sch2 { width:180px; height:112px; max-height:112px; margin-bottom:25px; padding:10px; font-size:1.7em; color:#2B7DC1; line-height:1.0; background:#E7EFFB; float:left;}
#division .sctxt { width:540px; margin-bottom:25px; font-size:1.5em; line-height:1.6; float:right;}
#division .infotxt { padding:25px 0 50px; border-top:1px solid #CCC; clear:both;}
#division .infotxt .txtbox { width:450px; float:left;}
#division .infotxt .imgbox { width:270px; float:right;}
#division .infotxt .imgbox .item { width:50%; padding:0 0 10px 0; text-align:center; font-size:1.3em; line-height:1.2; float:left; box-sizing:border-box;}
#division .infotxt .imgbox .oneitem { width:100%; padding:0 0 10px 0; text-align:center; font-size:1.3em; line-height:1.2; box-sizing:border-box;}
