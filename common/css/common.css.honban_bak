#division .voicebox .imgbox { width:155px; margin:0 20px 30px 50px; float:left;}
#division .voicebox P { margin-bottom:10px; font-size:1.4em; line-height:1.5;}
#division .voicebox .nametxt { display:inline; text-align:left; float:right;}
#division .kanribox { margin-bottom:30px;}
#division .kanribox h3 { margin-bottom:10px;}
#division .kanribox .kanriimg { width:160px; font-size:1.4em; text-align:center; float:left;}
#division .kanribox .kanritxt { width:550px; float:right;}
