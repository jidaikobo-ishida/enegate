#jigyousyo .kanribox .kanritxt { width:550px; float:right;}
#jigyousyo .kanribox .koujicase { margin:0 0 35px !important;}

#jigyousyo #kanri .sch2 { width:160px; height:112px; margin-bottom:20px; padding:10px; font-size:1.7em; color:#2B7DC1; line-height:1.0; background:#E7EFFB; float:left;}
#jigyousyo #kanri .sctxt { width:560px; margin-bottom:20px; font-size:1.5em; line-height:1.6; float:right;}
#jigyousyo #kanri .infotxt { padding:0;}
#jigyousyo #kanri .infotxt:last-child { border:none !important;}
#jigyousyo #kanri .voicebox { margin-bottom:40px; background:#E6EEFA url(../img/box_whsc.jpg) left top no-repeat;}
#jigyousyo #kanri .btmbd { border-bottom:1px solid #CCC; margin-bottom:10px !important;}
#jigyousyo #kanri .kanripo { padding-top:10px;}

#eco .section { width:850px; margin:0 auto; padding:0 0 25px 0;}
#eco .outline { padding-bottom:70px;}
#eco .outline P{ padding-left:38px;}
#eco .imgbox { margin-left:60px; float:right;}
#eco .btmline { border-bottom:1px solid #CCC;}
#eco .toppd { padding-top:40px;}
#eco .topendpd { padding:40px 0 50px;}
#eco .bltxttitle span { margin-right:15px; padding-right:15px; border-right:1px solid #CCC;}
#eco .bltxttitle strong { font-size:1.5em;}
#eco .copy { margin:15px 0 25px; font-size:1.6em; color:#2A7CC8; text-align:center;}
#eco .itembox { padding:20px 0; margin:0 6px 25px 0; width:208px; float:left; text-align:center; background:#E0E8EB; box-sizing: border-box;}
#eco .itembox:nth-child(6) { margin-right:0;}
#eco .itembox h4 { padding:20px 0 10px; font-size:1.5em;}
#eco .itembox p {padding-bottom:15px; font-size:1.4em;} 
#eco .itembox A.morelink{
	position: relative;
	display: inline-block;
	padding:6px 12px 6px 25px;
	font-size:1.3em;
	color:#2A7CC8;
	background:#FFF;
}

#eco .itembox A.morelink::before{
  content: '';
  width: 6px;
  height: 6px;
  border: 0px;
  border-top: solid 2px #2A7CC8;
  border-right: solid 2px #2A7CC8;
  -ms-transform: rotate(45deg);
  -webkit-transform: rotate(45deg);
  transform: rotate(45deg);
  position: absolute;
  top: 50%;
  left: 10px;
  margin-top: -4px;
}
#eco .itembox A.morelink:hover { color:#FFF; background:#2A7CC8;} 
#eco .itembox A.morelink:hover::before{
  border-top: solid 2px #FFF;
  border-right: solid 2px #FFF;
}

#eco .itembox .debbox A.nolink{
	position: relative;
	display: inline-block;
	padding:6px 12px 6px 25px;
	font-size:1.3em;
	color:#FFF;
	background:#CCC;
	cursor: default;
}

#eco .itembox .debbox A.nolink::before{
  content: '';
  width: 6px;
  height: 6px;
  border: 0px;
  border-top: solid 2px #FFF;
  border-right: solid 2px #FFF;
  -ms-transform: rotate(45deg);
  -webkit-transform: rotate(45deg);
  transform: rotate(45deg);
  position: absolute;
  top: 50%;
  left: 10px;
  margin-top: -4px;
}



#recruit{}
#recruit .blbgbtn{ font-size:18px; margin:0; padding:15px 30px; width:40%; float:left;}
#recruit .keiken { background:#CCC; float:right !important; border:#CCC;}
#recruit .keiken2{ font-size:18px; margin:0; padding:15px 30px; width:40%; float:right;}
#recruit .keiken:hover { color:#FFF;}
#recruit .keiken:hover::before{
border-top: solid 2px #FFF;
border-right: solid 2px #FFF;
}
#careers01 .careersmainnav { padding:15px 0 25px;}
#careers01 .careersmainnav li A {
	display:block;
	margin:0 15px 15px 0;
	width:362px;
	height:110px;
	font-size:1.7em; 
	line-height:1.0; 
	color:#FFF;
	font-weight:600;
	float:left;
	box-sizing: border-box;}

	
#careers01 .careersmainnav li img { display:inline-block; margin-right:28px; vertical-align:middle;}
#careers01 .careersmainnav li span { display:inline-block; vertical-align:middle;}
#careers01 .careersmainnav .btn01 A{ background:#2B7DC4;}
#careers01 .careersmainnav .btn02 A { background:#65AB5D;}
#careers01 .careersmainnav .btn03 A { background:#E2BF5D;}
#careers01 .careersmainnav .btn04 A { background:#0068B7; }
#careers01 .careersmainnav .btn05 A { background:#00BFFF; }
#careers01 .careersmainnav li:nth-child(2n) A { margin-right:0;}

#careers01 .debbox { padding:20px 0; margin:0 25px 25px 0; width:230px; float:left; text-align:center; background:#E7EFFB; border:1px solid #DBE4F5; box-sizing: border-box;}
#careers01 .debbox:nth-child(3n+3) { margin-right:0;}
#careers01 .debbox h3 { padding:15px 0 10px; font-weight:bold;}
#careers01 .debbox A.morelink{
	position: relative;
	display: inline-block;
	padding:6px 12px 6px 25px;
	font-size:1.3em;
	color:#2A7CC8;
	background:#FFF;
}

#careers01 .debbox A.morelink::before{
  content: '';
  width: 6px;
  height: 6px;
  border: 0px;
  border-top: solid 2px #2A7CC8;
  border-right: solid 2px #2A7CC8;
  -ms-transform: rotate(45deg);
  -webkit-transform: rotate(45deg);
  transform: rotate(45deg);
  position: absolute;
  top: 50%;
  left: 10px;
  margin-top: -4px;
}
#careers01 .debbox A.morelink:hover { color:#FFF; background:#2A7CC8;} 
#careers01 .debbox A.morelink:hover::before{
  border-top: solid 2px #FFF;
  border-right: solid 2px #FFF;
}

#careers01 .debbox A.nolink{
	position: relative;
	display: inline-block;
	padding:6px 12px 6px 25px;
	font-size:1.3em;
	color:#FFF;
	background:#CCC;
	cursor: default;
}

#careers01 .debbox A.nolink::before{
  content: '';
  width: 6px;
  height: 6px;
  border: 0px;
  border-top: solid 2px #FFF;
  border-right: solid 2px #FFF;
  -ms-transform: rotate(45deg);
  -webkit-transform: rotate(45deg);
  transform: rotate(45deg);
  position: absolute;
  top: 50%;
  left: 10px;
  margin-top: -4px;
}



#careers01 .voicebox { width:100%; margin-bottom:35px; background:#EEEEEE url(../img/box_whsc.jpg) left top no-repeat;}
#careers01 .voicebox img { margin:30px 20px 30px 30px; float:left;}
#careers01 .voicebox h3 { padding:30px 0 15px; font-size:1.6em; line-height:1.6; color:#2B7DC0;}
#careers01 .voicebox P { padding:0 20px 30px; font-size:1.4em; line-height:1.6;}
#careers01 .voicefaq dt { margin:10px 0; font-size:1.5em; font-weight:600; color:#0021BA;}
#careers01 .voicefaq dt span {
	margin-right:10px;
	padding:3px 6px;
	color:#FFF;
	text-align:center;
	background:#0021BA;
	border-radius: 5px;
	-moz-border-radius: 5px;
	-webkit-border-radius: 5px;}
#careers01 .voicefaq dd { margin:10px 0 25px; font-size:1.4em;}
#careers01 .jisseki li { display:inline-block; width:33%; font-size:1.4em; line-height:1.8;}
#careers01 .jisseki span { color:#2B7DC0; margin-right:5px;}
#careers01 .graytb th { width:120px;}
#careers02 .graytb th { width:120px;}

#form .section { min-height:400px;}
#form input,
#form textarea,
#form select {
	margin:0;
	padding:2px 3px;
	font-size:14px;
	border:1px solid #999;
	background-color: #fff;
	vertical-align:middle;
}
#form .px12_red { color:#E31F19;}
#form .graytb { margin-bottom:30px;}
#form .orei { width:70%; padding:30px; margin:50px auto; background:#E8F0FB; text-align:center;}
#form h2 { margin-bottom:15px; font-size:1.6em; font-weight:600; color:#2B7CCB; line-height:1.8;}
#form p { font-size:1.4em; line-height:1.8;}
#FormButtons { margin:30px; text-align:center;}

#FormButtons .submit_button { text-align:center; margin:15px 0;}	
#FormButtons .submit_button {
	width:100px;
	margin:10px;
    padding: 5px 10px;
    font-size: 1.5em;
    background-color:#2B7CCB;
    color: #fff;
    border-style: none;
	cursor:pointer;
}
#FormButtons .reset_button {
	width:100px;
	margin:10px;
    padding: 5px 10px;
    font-size: 1.5em;
    background-color:#E0E8EB;
    color: #666;
    border-style: none;
	cursor:pointer;
}
#veri { margin:15px 0 50px;}


/*table*/
table.graytb { border:1px solid #CCC;}
table.graytb th {padding:5px 10px; font-size:1.4em;  color:#FFF; background:#7F7F7F; vertical-align:top; border-bottom:solid 1px #CCC;}
table.graytb td {padding:5px 10px; font-size:1.4em;  vertical-align:top; border-bottom:solid 1px #CCC;}
table.graytb strong { font-weight:600;}

/*List*/
ol.decimal li { margin:0 0 0 1.4em; list-style-type:decimal; font-size:14px !important;}
ol.decimal ol li { margin:0 0 0 10px; list-style-type:none; font-size:14px !important;}
ul.disc li { margin:0 0 0 1.4em; list-style-type:disc; font-size:14px !important;}
#iteminfo ul.disc li { position:relative; list-style-type:none; margin-left:0; padding-left:0.8em; line-height:1.5;}
#iteminfo ul.disc li::before{
  content: '●';
  width:14px;
  height:14px;
  border: none;
  color:#333;
  line-height:1.5;
  -ms-transform:none;
  -webkit-transform:none;
  transform: none;
  position: absolute;
  top:-1px;
  left:0;
}

table.graytb ol.decimal li,
table.graytb ol.decimal ol li,
table.graytb ul.disc li {  font-size:14px !important;}

/*TOPICS*/
#topics h1 strong,
#topics h2 strong{ font-size:1.5em;}
#topics .topicslist { margin-bottom:50px; border-bottom:1px solid #E1E1E1;}
#topics .topicslist dt:first-child,
#topics .topicslist dd:nth-child(2) { border-top:none;}
#topics .topicslist dt { padding:1em 0; width:100px; font-size:1.4em; float:left;  border-top:1px solid #E1E1E1;}
#topics .topicslist dd { margin:0 0 0 100px; padding:1em 0 1em 85px; font-size:1.4em; border-top:1px solid #E1E1E1;text-indent:-85px;}
#topics .topicslist A { color:#2B7DC0;}
#topics .topicslist A:hover { 
opacity:0.6;
-webkit-opacity:0.6;
-moz-opacity:0.6;
filter: alpha(opacity=60);
-ms-filter: "alpha(opacity=60)";}
#topics .topicslis dd:after {
  content: '';
  display: block;
  clear: both;
}
#topics .topicslist span { display:inline-block; width:50px; margin-right:25px; padding:1px 5px; font-size:0.8em; color:#FFF;text-align:center; text-indent:0;}
#topics .topicslist .topiclb { background:#EB7846;}
#topics .topicslist .companylb { background:#286E99;}
#topics .topicslist .eventlb { background:#3D8B7E;}
#topics .topicslist .studylb { background:#3387D9;}
#topics .topicslist .productlb { background:#EB8CB7;}

#newsnote h2 { font-weight:bold; color:#000;}
#newsnote h2 .day { display:inline; font-size:0.9em; }
#newsnote h2 .topiclb { display:inline-block; width:100px; margin-left:0.5em; padding:3px 5px; font-size:0.8em; color:#FFF; text-align:center; background:#EB7846;}
#newsnote h2 .companylb { display:inline-block; width:100px; margin-left:0.5em; padding:3px 5px; font-size:0.8em; color:#FFF; text-align:center;  background:#286E99;}
#newsnote h2 .eventlb { display:inline-block; width:100px; margin-left:0.5em; padding:3px 5px; font-size:0.8em; color:#FFF; text-align:center;  background:#3D8B7E;}
#newsnote h2 .studylb { display:inline-block; width:100px; margin-left:0.5em; padding:3px 5px; font-size:0.8em; color:#FFF; text-align:center;  background:#3387D9;}
#newsnote h2 .productlb { display:inline-block; width:100px; margin-left:0.5em; padding:3px 5px; font-size:0.8em; color:#FFF; text-align:center;  background:#EB8CB7;}
#newsnote h2 .title { display:block; margin-top:14px;}
#newsnote h3 { font-weight:bold; clear:both;}
#newsnote P { margin-bottom:1.5em; font-size:1.4em; line-height:1.7;}
#newsnote A { color:#2B7DC0;}
#newsnote .imgleft { width:200px; float:left; margin:0 25px 25px 0;}
#newsnote .imgright { width:200px; float:right; margin:0 0 25px 25px;}
#newsnote .imgcenter { width:100%; margin:25px auto; text-align:center; clear:both;}
#newsnote .caption { margin:5px 0 0 0; font-size:1.3em; line-height:1.4; text-align:center;}
#newsnote .disc,
#newsnote .decimal { margin-bottom:25px;}
#newsnote table { margin-bottom:25px;}
#newsnote table small { font-size:0.85em;}
.backbt { padding-bottom:50px;}