/*mainImg*/
#mainimg { overflow:hidden; position:relative;}
#mainimg .maincopy { position:absolute; top:41.6%; width:100%; font-size: 4.0em; color: #fff; font-weight: 700; text-align:center; z-index:200;text-shadow :1px 1px 3px #666,
	-1px 1px 3px #666,
	1px -1px 3px #666,
	-1px -1px 3px #666;}
#mainimg .mainlogo { position:absolute; bottom:5px; width:100%; text-align:right; z-index:300;}
#mainimg .mainlogo P { width:950px; margin:0 auto;}

#mainimg .slider { height:520px; overflow:hidden;}
#mainimg .slide01,
#mainimg .slide02,
#mainimg .slide03,
#mainimg .slide04,
#mainimg .slide05 { height:520px;}
#mainimg .slide01 { background:url(../img/slid_01.jpg) no-repeat center center; background-size:cover;}
#mainimg .slide02 { background:url(../img/slid_02.jpg) no-repeat center center; background-size:cover;}
#mainimg .slide03 { background:url(../img/slid_03.jpg) no-repeat center center; background-size:cover;}
#mainimg .slide04 { background:url(../img/slid_04.jpg) no-repeat center center; background-size:cover;}
#mainimg .slide05 { background:url(../img/slid_05.jpg) no-repeat center center; background-size:cover;}

#mainimg .slick-prev,
#mainimg .slick-next {
	position:absolute;
	top:45%;
  width:46px;
  height:46px;
	cursor:pointer;
}
#mainimg .slick-prev { background:url(../img/sl_arrow.png); border:none;}
#mainimg .slick-next { background:url(../img/sl_arrow2.png); border:none;}
#mainimg .slick-prev:focus,
#mainimg .slick-next:focus {outline:none;}


#mainimg .slick-prev:before, 
#mainimg .slick-next:before {
    content:"";
}
#mainimg .slick-prev, 
#mainimg .slick-next {
    z-index:500;
}
#mainimg .slick-prev{left:20px;}
#mainimg .slick-next{right:20px;}

#mainimg .slick-arrow{z-index:10000;}
#mainimg .dotrt .slick-dots {flex-direction: row-reverse; }


#mainimg #line1,
#mainimg #line2,
#mainimg #line3{
	position: absolute;
	bottom: 10px;
	left: 0;
	z-index:200;
}
#mainimg #line1{
	width:1900px;
	height:168px;
	background:url("../img/line_01.png") repeat-x;
}
#mainimg #line2{
	width:1900px;
	height:112px;
	bottom: 30px;
	background:url("../img/line_02.png") repeat-x;
}
#mainimg #line3{
	width:1900px;
	height:132px;
	background:url("../img/line_03.png") repeat-x;
}

.updw {
  animation: updw 2.5s infinite;
}
.rota {
  animation: rota 3.7s infinite;
}
.slidein {
  animation: slideIn 2s ease-in;
} 
.slidein2 {
  animation: slideIn 2.5s ease-in;
} 

@keyframes updw {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-2px);
  }
}
@keyframes rota {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(1px);
  }
}
@keyframes slideIn {
  0% {
    transform: translateX(-1900px);
    opacity: 0;
  }
	100% {
    transform: translateX(0);
    opacity: 1;
  }
}


/*Imgnav*/
#Imgnav { padding: 0; position:relative; overflow:hidden; background:#d4dce0;background:#000;}
#Imgnav .Imgnavwrap{ display:flex; justify-content: space-between; width:950px; margin:0 auto; overflow:hidden;background: #fff;}
#Imgnav A{
	display: flex;
	justify-content: center;
	align-items: center;
	align-content: space-around ;
	flex-wrap: wrap;
	padding: 1em 0;
	width : 16.66666% ;
	width : -webkit-calc(100% / 6) ;
	width : calc(100% / 6) ;
	font-size:1.65em;
	line-height:1.5; 
	color:#FFF; 
	text-align:center; 
	z-index:100;}
#Imgnav A:last-child{margin-right: 0;}

#Imgnav img { margin:1em auto 0.5em;}
#Imgnav .imgnav01 { background:#000;}
#Imgnav .imgnav02 { background:#000;}
#Imgnav .imgnav03 { background:#000;}
#Imgnav .imgnav04 { background:#000;}
#Imgnav .imgnav05 { background:#000;}
#Imgnav .imgnav06 { background:#f7931e;}
#Imgnav span { width: 100%; display: block;} 

#Imgnav:before {
    width: 50%;
    height: 100%;
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    background: #f7931e;
	z-index:0;
}
#Imgnav .wrap {
    position: absolute;
    left: 50%;
    margin-left: -475px;
}

/*ProductsNav*/
#productsnav { height:70px; background:#000; position:relative; overflow:hidden;}
#productsnav .prosnavwrap { width:950px; margin:0 auto; background:#FFF;}
#productsnav A { 
	display:block; 
	width : 16.66666% ;
	width : -webkit-calc(100% / 6) ;
	width : calc(100% / 6) ;
	height:70px; 
	padding:0; 
	font-size:1.3em; 
	line-height:1.5; 
	color:#FFF; 
	text-align:center; 
	float:left; 
	z-index:100;}
#productsnav .imgnav01 { background:#000; padding-top:18px;}
#productsnav .imgnav02 { background:#000; line-height:70px;}
#productsnav .imgnav03 { background:#000; line-height:70px;}
#productsnav .imgnav04 { background:#000; line-height:70px;}
#productsnav .imgnav05 { background:#000; line-height:70px;}
#productsnav .imgnav06 { background:#f7931e; line-height:70px;}
#productsnav:before {
    width: 50%;
    height: 100%;
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    background: #f7931e;
	z-index:0;
}
#productsnav .wrap {
    position: absolute;
    left: 50%;
    margin-left: -475px;
}
#productsnav .letsp {letter-spacing:-1px;}


#allproductsnav { margin-bottom:35px; height:50px; background:#000; position:relative; overflow:hidden;}
#allproductsnav .prosnavwrap { width:950px; margin:0 auto; background:#FFF;}
#allproductsnav A { 
	display:block;
	width :16.66666% ;
	width :-webkit-calc(100% / 6) ;
	width :calc(100% / 6) ;
	height:50px;
	margin:0;
	padding:0;
	font-size:13px;
	line-height:17px; 
	color:#FFF; 
	text-align:center; 
	float:left; 
	z-index:100;}

#allproductsnav .imgnav01 { background:#000; padding-top:9px;}
#allproductsnav .imgnav02 { background:#000; line-height:50px;}
#allproductsnav .imgnav03 { background:#000; padding-top:9px;}
#allproductsnav .imgnav04 { background:#000; line-height:50px;}
#allproductsnav .imgnav05 { background:#000; padding-top:9px;}
#allproductsnav .imgnav06 { background:#f7931e; padding-top:9px;}
@media all and (-ms-high-contrast: none){
#allproductsnav A {line-height:18px; } 
}
#allproductsnav:before {
    width: 50%;
    height: 100%;
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    background: #f7931e;
	z-index:0;
}
#allproductsnav .wrap {
    position: absolute;
    left: 50%;
    margin-left: -475px;
}
#allproductsnav .letsp {letter-spacing:-1px;}


@media screen and (max-width:1100px) {
#productsnav .prosnavwrap { background:#74C1A4;}
}

/*banner*/
#contentbanner { padding:40px 0 60px; background:#d4dce0;}
#contentbanner h2 { margin-bottom:5px; font-size:3em; font-weight: 700;}
#contentbanner .mainbanner { width:100%;display: flex;flex-wrap: wrap;}
#contentbanner .subbanner { width:100%;display: flex; justify-content: space-between; margin-top: 50px;}
#contentbanner .mainbanner h3 {display: block; margin:2em 0 1em; padding-left:0.9em; font-size: 1.6em; font-weight:bold; line-height: 1.3; position: relative; z-index: 2;}
#contentbanner .mainbanner h3::after {
  content: "";
	position: absolute;
	top: 0.25em;
	left: 0;
  width: 0;
  height: 0;
  border-style: solid;
  border-top: 9px solid transparent;
  border-bottom: 9px solid transparent;
  border-left: 16px solid #ffcc00;
  border-right: 0;
}
#contentbanner .mainbanner small { display: block; margin-top: 0.3em; font-size: 0.65em; font-weight:bold; position: relative; z-index: 2;}

#contentbanner .mainbanner a:hover h3,
#contentbanner .mainbanner a:hover small {
	text-shadow :1px 1px 3px #555,
	-1px 1px 3px #555,
	1px -1px 3px #555,
	-1px -1px 3px #555;} 

#contentbanner .mainbanner a { display: flex; justify-content: center;flex-direction: column; width :calc(100% / 3); height: 300px; padding: 0 1em 0 1.8em; color: #fff; font-size: 1.6em; font-weight: 700; box-sizing: border-box; position: relative; overflow: hidden;} 
#contentbanner .mainbanner a:nth-child(even){}
#contentbanner .mainbanner a.mkbl::before,
#contentbanner .mainbanner a.mkgr::before {
  content: "";
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  transform: translateY(0);
	transition: .2s ease-in-out;
	z-index: 0;
}
#contentbanner .mainbanner a.mkbl::before{background: rgba(0,32,151,0.5);}
#contentbanner .mainbanner a.mkgr::before{background: rgba(59,56,57,0.5);}
#contentbanner .mainbanner a.mkbl:hover::before,
#contentbanner .mainbanner a.mkgr:hover::before{
  transform: translateY(-100%);
}
#contentbanner .mainbanner a h3 { opacity: 1; transition: .3s;}
#contentbanner .mainbanner a:hover h3 {margin-top: 1em; opacity: 1; transform: translateY(0);}
#contentbanner .mainbanner a small { opacity: 1; transition: .3s;transform: translateY(0);}
#contentbanner .mainbanner a:hover small { opacity: 1; transition: .3s; transform: translateY(0);}
#contentbanner .mainbanner sup {margin-left: 0.2em; font-size: 0.75em;}

#contentbanner .mainbanner .pk01 { background: url("../img/banner_qden_img.jpg") no-repeat center center / cover;}
#contentbanner .mainbanner .pk02 { background: url("../img/banner_eco_img.jpg") no-repeat center center / cover;}
#contentbanner .mainbanner .pk03 { background: url("../img/banner_meter1_img.jpg") no-repeat center center / cover;}
#contentbanner .mainbanner .pk04 { background: url("../img/banner_meter2_img.jpg") no-repeat center center / cover;}
#contentbanner .mainbanner .pk05 { background: url("../img/banner_gateway_img.jpg") no-repeat center center / cover;}
#contentbanner .mainbanner .pk06 { background: url("../img/banner_svare_img.jpg") no-repeat center center / cover;}

#contentbanner .subbanner img {vertical-align: middle;}

/*EX*/
#event { padding:40px 0 60px; background: #f2f2f2 url("../img/event_bk.jpg") no-repeat center bottom / cover;}
#event h2 { margin-bottom:5px; font-size:3em; font-weight: 700;}
#event .banner { width:100%; display: flex; justify-content: space-between; margin: 1em 0 0 !important;}

/*Banner 2&3column*/
#event.banner_col2 ul{
	display: flex;
	justify-content: space-between;
	align-items: flex-start;
	margin: 2em 0 0;
	padding: 0;
	list-style: none;
}
#event.banner_col2 li{
	width: calc(50% - 15px);
}
#event.banner_col3 ul{
	display: flex;
	justify-content: space-between;
	margin: 2em 0 0;
	padding: 0;
	list-style: none;
}
#event.banner_col3 li{
	width: calc((100% / 3) - 20px);
}
#event.banner_col2 img,
#event.banner_col3 img{
	width: 100%;
	height: auto;
}
#event.banner_col2 p,
#event.banner_col3 p{
	margin: 0.5em 0 0;
	font-size: 1.6em;
	font-weight: 700;
	line-height: 1.5;
}
#event.banner_col2 p a,
#event.banner_col3 p a{
	display: block;
  padding-left: 1.5em;
	color: #001a7b;
	position: relative;
}
#event.banner_col2 p a::before,
#event.banner_col3 p a::before{
	content: "→";
	position: absolute;
	top: 0;
	left: 0;
}

/*Banner accordion*/
.bnaccordion {
	margin-top: 50px;
	background: none;
}
.bnaccordion .toggle {
	display: none;
}
.bnaccordion .Label {
	padding: 1em;
	display: block;
	color: #fff;
	font-size: 1.6em;
	text-align: center;
	background:#4e609d;
	cursor: pointer;
}
.bnaccordion .Label::before{
	content:"";
	width: 6px;
	height: 6px;
	border-top: 2px solid #fff;
	border-right: 2px solid #fff;
	position: absolute;
	top:calc( 50% - 3px );
	right: 20px;
	transform: rotate(135deg);
}
.bnaccordion .Label,
.bnaccordion .acbox {
	backface-visibility: hidden;
	transform: translateZ(0);
	transition: all 0.3s;
}
.bnaccordion .acbox {	
	margin-top: 2em !important;
	height: 0;
	overflow: hidden;
}
.bnaccordion .toggle:checked + .Label + .acbox {
	height: auto;
	transition: all .3s;
}
.bnaccordion .toggle:checked + .Label::before {
	transform: rotate(-45deg) !important;
}

/*news*/
#news { padding:50px 0;}
#news h2 {margin-bottom: 0.5em; font-size:3em; line-height: 1.2; font-weight: 700;}
#news .enebo{margin-left: 20px;}
#news .newlist { width:650px; float:right;}
#news .newlist dt { margin-bottom:10px; width:100px; font-size:1.4em; float:left; clear:left;}
#news .newlist dd { margin:0 0 10px 100px; padding-left: 1em; font-size:1.4em; position: relative;}
#news .newlist A { color:#2B7DC0;}
#news .newlist A:hover { 
opacity:0.6;
-webkit-opacity:0.6;
-moz-opacity:0.6;
filter: alpha(opacity=60);
-ms-filter: "alpha(opacity=60)";}
#news .newlist A::before {
	content: "";
	position: absolute;
	top: 0.5em;
	left: 0;
  width: 0;
  height: 0;
  border-style: solid;
  border-top: 4px solid transparent;
  border-bottom: 4px solid transparent;
  border-left: 6px solid #ec8313;
  border-right: 0;
}
#news .newlist span { display:inline-block; width:50px; margin-right:25px; padding:1px 5px; font-size:0.8em; color:#FFF;text-align:center;}
#news .newlist .topiclb { background:#EB7846;}
#news .newlist .companylb { background:#286E99;}
#news .newlist .eventlb { background:#3D8B7E;}
#news .newlist .studylb { background:#3387D9;}
#news .newlist .productlb { background:#EB8CB7;}
#news .newlist .attinfo { font-size:1.4em; color:#E31F19;}
#news .newlist .morenews{
	position: relative;
	display: inline-block;
	margin-top:18px;
	padding-left:15px;
	font-size:1.3em;
	color:#808080;
}
#news .newlist .morenews::before{
  content: '';
  width: 6px;
  height: 6px;
  border: 0px;
  border-top: solid 1px #808080;
  border-right: solid 1px #808080;
  -ms-transform: rotate(45deg);
  -webkit-transform: rotate(45deg);
  transform: rotate(45deg);
  position: absolute;
  top: 50%;
  left: 0;
  margin-top: -4px;
}


/*footer*/
