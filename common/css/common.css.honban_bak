@charset "shift-jis";
html{overflow-y: scroll;}
body{
font-family:"Helvetica Neue" , Helvetica , Arial , "ヒラギノ角ゴ Pro W3" , "Hiragino Kaku Gothic Pro" ,  "Meiryo" , "メイリオ" , Meiryo , "ＭＳ Ｐゴシック" , "MS PGothic" , sans-serif;
font-size: 62.5%;
text-align:left;
background-image:none;
background:#FFF;
-webkit-text-size-adjust: 100%;
-webkit-font-smoothing: antialiased;
min-width: 950px;
}
.fyou {font-family: YuGothic, "Yu Gothic Medium", "Yu Gothic", sans-serif;}

/**/
#article {  font-size: 13px; *font-size: small; /* IE7+ */ *font: x-small; /* IE6- */}
.type01 li,
.disc li,
.decimal li{ font-size:13px !important;}
.boxTop,.boxBtm { line-height:0;}
#faq .group.qa dd {margin-left:13em;margin-top:-5.5em;padding:0 15px 0 0;}
#company #article #mainContent #top {margin: 0px;padding: 0px;height: 90px;width: 690px;background: url(../../now/img/h1_enegatenow.gif);}
#company #article #mainContent #history {margin: 0px;padding: 0px;height: 90px;width: 690px;background: url(../../now/img/h1_history.gif);}
#company #article #mainContent #ayumi-title {margin: 0px;padding: 0px;height: 90px;width: 690px;background: url(../../now/img/h1_ayumi.gif);}
#company #article #mainContent #principle {margin: 0px;padding: 0px;height: 90px;width: 690px;background: url(../../now/img/h1_principle.gif);}
#company #article #mainContent #takumi {margin: 0px;padding: 0px;height: 90px;width: 690px;background: url(../../now/img/h1_takumi.gif);}
#mainContent form th {width:180px;}
#mainContent form th input,
#mainContent form td input{ margin-bottom:0;}
#form1 input { font-size:13px;}
#FormButtons input { padding:10px; margin-top:10px;}
#products .type01 li { font-size:12px !important;}
/**/


A, A:hover { text-decoration:none; color:#0021BD;}
a.fade:hover,
a.fade:hover img {
opacity:0.75;
filter: alpha(opacity=75);
-ms-filter: "alpha(opacity=75)";
}

a.fade,
a.fade img {
-webkit-transition: opacity 0.5s ease-out;
-moz-transition: opacity 0.5s ease-out;
-ms-transition: opacity 0.5s ease-out;
transition: opacity 0.5s ease-out;
}
.min { font-size:80% !important;}
div,table,td,tr,li,dt,dd{ box-sizing: border-box;}
.clearfix:after {
  content: "";
  display: block;
  clear: both;
  height: 0;
  visibility: hidden;
}
.clearfix {
  min-height: 1px;
}
* html .clearfix {
  height: 1px;
  /*\*//*/
  height: auto;
  overflow: hidden;
  /**/
}
.cl { clear:both;}

/* ------------------------------*/
.lflt { float:left; }
.rflt { float:right;}

/* ------------------------------*/
.txtl { text-align:left !important;}
.txtc { text-align:center !important;}
.txtr { text-align:right !important;}

/* ------------------------------*/
.red { color:#E31F19;}
.green { color:#009C70;}
/* ------------------------------*/

.pcno { display:none !important;;}

#header { width:100%; background:#001a7b;overflow: hidden;}
#header .logo { margin:27px 0 14px;}
#header .group { position:absolute; top:10px; right:0;}
#header form { position: relative;}
#header .search { position:absolute; top:38px; right:0; width:300px; color:#fff;}
#header .search input[type=radio] { display: none;}
#header .search .radiobox { float:left;}
#header .search .radiobox input{display: none;}
#header .search .radiobox label{
	display: inline-block;
	position: relative;
	cursor: pointer;
	margin: 8px 12px 0 0;
	padding: 0 0 0 8px;
	border-radius: 2px;
	color: #fff;
	font-size: 1.1em;
	text-align: center;
	line-height: 1;
}
#header .search .radiobox label:before{
	position: absolute;
	content: "";
	top: 40%;
	left: -4px;
	width: 8px;
	height: 8px;
	margin-top: -4px;
	background: #002097;
	border-radius: 50%;
	border:1px solid #fff;
}
#header .search .radiobox input[type="radio"]:checked + label:after {
	position: absolute;
	content: "";
	top: 40%;
	left: -1px;
	width: 4px;
	height: 4px;
	margin-top: -1px;
	border-radius: 50%;
	background: #fff;
}
#header .search .searchbox{
	position:relative;
	float:right;
	border:2px solid #fff;
}
#header .search .searchbox .keytxt{
	margin:0 24px 0 0;
	padding:0;
	height:20px;
  }
#header .search .searchbox .keytxt input{
  width:100px;
	margin:2px 0 0;
	padding:0 8px;
	color: #fff;
	font-size:1.1em;
	height:16px;
	background:none;
	border:none;
	box-sizing: border-box;
    }
#header .search .searchbox .keybtn{
        position:absolute;
        top:-1px;
        right:0;
    }
#header .search .searchbox .keybtn button{
        display:block;
        padding:0;
        background:none;
        border:none;
    }
#header .search .searchbox .keybtn button span{
        display:block;
        width:18px;
        height:18px;
        background:url('../img/search_icon_wh.png') no-repeat scroll -2px 2px;
    }
#header .hdsub { 
	position:absolute; 
	top:40px; 
	left:420px; 
	padding:3px 20px 3px 0; 
	font-size:10px; 
	border-right:1px solid #fff;}
#header .hdsub A {
	margin-left:14px;
	color:#fff;
    position: relative;
    display: inline-block;
    padding-left: 13px;
	line-height:1.0;
}
#header .hdsub A:before {
    content: '';
    width: 10px;
    height: 10px;
    background: #fff;
    position: absolute;
    top: 50%;
    left: 0;
    margin-top: -5px;
}
#header .hdsub A:after {
    content: '';
    width: 3px;
    height: 3px;
    border: 0px;
    border-top: solid 1px #002097;
    border-right: solid 1px #002097;
    -ms-transform: rotate(45deg);
    -webkit-transform: rotate(45deg);
    transform: rotate(45deg);
    position: absolute;
    top: 50%;
    left: 2px;
    margin-top: -2px;
}

@media all and (-ms-high-contrast: none){
#header .hdsub A:before {
    top: 4px;
}
#header .hdsub A:after {
    top: 4px;
}
}

/*globalnav*/
.accordion {background:#fff; text-align: center; border-bottom: 1px solid #ccc;}
#globalnav {background:#fff;}
#globalnav ul { width:950px; margin: 0.5em auto 0; justify-content: space-between; display: flex; box-sizing: border-box;}
#globalnav li { width:calc(100% / 6); margin: 0.7em 0 0.7em; font-size:1.5em; text-align: center; border-right: 1px solid #002097;}
#globalnav li:first-child{ border-left: 1px solid #002097;}
#globalnav li.pcno { display:none;}
#globalnav li A { display:block; color:#333; box-sizing: border-box;}

/*パンくず*/
#breadcrumbs { padding:10px 0 30px;}
.breadcrumbslist li { display:inline; margin:12px 10px 12px 0; padding:0 16px 0 0; font-size:1.2em; position:relative;}
.breadcrumbslist li a { color:#2B7DBF !important;}
.breadcrumbslist li a:hover { color:#666 !important;}
.breadcrumbslist li a::after{
  content: '';
  width: 6px;
  height: 6px;
  border: 0px;
  border-top: solid 1px #808080;
  border-right: solid 1px #808080;
  -ms-transform: rotate(45deg);
  -webkit-transform: rotate(45deg);
  transform: rotate(45deg);
  position: absolute;
  top: 50%;
  right:4px;
  margin-top: -4px;
}

.full{ min-width: 100vw;margin-left: calc(-50vw + 50%);}
@media screen and (max-width: 950px){
.full{ min-width: 950px; margin-left:0;}
}

#content { width:100%; min-width:950px; overflow:hidden;}
.section { margin:0 auto 30px;}
.inner { width:950px; margin:0 auto; position:relative;}
.inner900 { width:900px; margin:0 auto; padding-bottom:50px; overflow:hidden; position:relative;font-family:"Helvetica Neue" , Helvetica , Arial , "ヒラギノ角ゴ Pro W3" , "Hiragino Kaku Gothic Pro" ,  "Meiryo" , "メイリオ" , Meiryo , "ＭＳ Ｐゴシック" , "MS PGothic", sans-serif; }
.twocontent { width:740px; padding-bottom:45px; float:right;}
.colsec3 { padding:10px; width:33.33%; float:left;}

.titleimg { margin-bottom:15px;}
.grytitle  { margin-bottom:30px; padding:15px 0 14px 12px; font-size:1.9em; line-height:1.0; border-top:1px solid #A4A4A5; border-bottom:1px solid #A4A4A5; font-weight:bold;}
.blbktitle  { margin-bottom:25px; padding:10px 15px; font-size:1.7em; color:#2B7DC1; line-height:1.0; background:#E7EFFB;}
.bldottitle  {margin:20px 20px 10px 30px; float:left;; padding:0 0 0 23px; font-size:1.6em; color:#2B7DC1; line-height:1.0; background:url(../img/bl_dot.png) no-repeat left center; background-size:13px auto;}
.bltxttitle { margin-bottom:15px; font-size:2.0em; color:#2B7CCB;}
.blsubtxt  { margin-bottom:5px; padding:0; font-size:1.5em; color:#2B7DC1; line-height:1.7;}
.dblbktitle { margin-bottom:30px; padding:12px 25px; font-size:21px; background:#DFE7EB;}
.bldisctitle { margin-bottom:15px; padding-left:36px;  font-size:2.0em; color:#2B7CCB; background:url(../img/br_arrow.png) left center no-repeat;}
*::-ms-backdrop, _:-ms-lang(x), .grytitle { padding:15px 0 11px 12px;}
*::-ms-backdrop, _:-ms-lang(x), .dblbktitle { padding:12px 25px 9px;}

.section .ptext { font-size:1.5em; margin-bottom:25px;}
.section .ntext { font-size:1.4em; margin-bottom:25px;}

.blbgbtn {
	margin:15px 0;
	position: relative;
	display: inline-block;
	padding:6px 12px 6px 25px;
	margin:15px 10px 0 0;
	font-size:1.3em;
	color:#FFF;
	background:#2A7CC8;
	 border:1px solid #2A7CC8;
}
.blbgbtn::before{
  content: '';
  width: 6px;
  height: 6px;
  border: 0px;
  border-top: solid 2px #FFF;
  border-right: solid 2px #FFF;
  -ms-transform: rotate(45deg);
  -webkit-transform: rotate(45deg);
  transform: rotate(45deg);
  position: absolute;
  top: 50%;
  left: 10px;
  margin-top: -4px;
}
.blbgbtn:hover {
	color:#2A7CC8; 
	background:#FFF;
}
.blbgbtn:hover::before{
  border-top: solid 2px #2A7CC8;
  border-right: solid 2px #2A7CC8;
}

A.grytextbtn{
	position: relative;
	display: inline-block;
	padding-left:15px;
	font-size:1.3em;
	color:#8C8C8C;
}
A.grytextbtn:hover{color:#8C8C8C;}
A.grytextbtn::before{
  content: '';
  width: 6px;
  height: 6px;
  border: 0px;
  border-top: solid 1px #8C8C8C;
  border-right: solid 1px #8C8C8C;
  -ms-transform: rotate(45deg);
  -webkit-transform: rotate(45deg);
  transform: rotate(45deg);
  position: absolute;
  top: 50%;
  left: 0;
  margin-top: -4px;
}


.leftsubnav{ width:180px; margin-bottom:50px; float:left; border:1px solid #C8C8C8; border-bottom:none;text-align: left;}

.leftmenu ul { display:none;}
.leftmenu .current { display:block !important;}

.leftsubnav .navtitle { font-size:1.4em; background:#609ECB; color:#FFF;text-align: left;}
.leftsubnav .navtitle big{ padding-left:15px; line-height:35px; font-size:1.0em; box-sizing: border-box;}
.leftsubnav .navtitle img{ padding:0 15px 0 15px;}
.leftsubnav .navtitle A { display:block; color:#FFF;}
.leftsubnav .navtitle A:hover { color:#F1F1F1;}

.leftsubnav .leftmenu li{ position:relative; display:block; font-size:0.85em; box-sizing: border-box; border-bottom:1px solid #C8C8C8; background:#FFF;text-align: left;}
.leftsubnav .leftmenu li A{ display:block; color:#000; padding:8px 5px 6px 16px;}
.leftsubnav .leftmenu li A:hover { background:#DCE5F6; color:#000;}
.leftsubnav .leftmenu li A::before{
  content: '';
  width: 5px;
  height: 5px;
  border: 0px;
  border-top: solid 1px #808080;
  border-right: solid 1px #808080;
  -ms-transform: rotate(45deg);
  -webkit-transform: rotate(45deg);
  transform: rotate(45deg);
  position: absolute;
  top:15px;
  left: 5px;

}
.leftsubnav .leftmenu li A:hover::before { border-top: solid 1px #FFF; border-right: solid 1px #FFF;}

.leftsubnav .leftmenu .leftsub li { position:relative; font-size:1.0em; box-sizing: border-box; border-bottom:1px solid #FFF;}
.leftsubnav .leftmenu .leftsub li A { display:block; padding:3px 0 3px 24px;}
.leftsubnav .leftmenu .leftsub li A::before{
  content: '';
  width: 3px;
  height: 3px;
  border: 0px;
  border-top: solid 1px #808080;
  border-right: solid 1px #808080;
  -ms-transform: rotate(45deg);
  -webkit-transform: rotate(45deg);
  transform: rotate(45deg);
  position: absolute;
  top:10px;
  left:16px;
}
.leftsubnav .leftmenu .leftsub li.leftsubdot A { display:block; padding:3px 0 3px 35px;}
.leftsubnav .leftmenu .leftsub li.leftsubdot A::before{
  content: '■';
  width: 3px;
  height: 3px;
  border: none;
  color:#609ECB;
  -ms-transform:none;
  -webkit-transform:none;
  transform: none;
  position: absolute;
  top:2px;
  left:24px;
}
.currentbkc { background:#DCE5F6 !important;}
ul.click-hover_menu_ch input { display: none; }
ul.click-hover_menu_ch .nvliti { display:block; cursor:pointer;}

